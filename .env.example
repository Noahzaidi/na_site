# Copy to .env.local to override locally. All values are public and end up in the built HTML.

# "production" allows search indexing. Anything else builds a noindex preview.
NEXT_PUBLIC_SITE_ENV=preview

# Destination for every primary CTA. Defaults to the NoahArk Calendly page when blank.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/noahzaidi/noahark-discovery-call

# Public contact address. Must be a confirmed, working @noahark.org mailbox. Leave blank to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=
